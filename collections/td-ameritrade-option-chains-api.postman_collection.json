      "item": [
        {
          "id": "e1d7d1d1-dbf3-4ec1-86c9-43ac81c9a280",
          "name": "Get Option Chains for optionable symbols",
          "request": {
            "name": "Get Option Chains for optionable symbols",
            "description": {
              "content": "Get option chain for an optionable Symbol",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "marketdata",
                "chains"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "(Required) API Key"
                },
                {
                  "disabled": false,
                  "key": "symbol",
                  "value": "<string>",
                  "description": "(Required) Enter one symbol"
                },
                {
                  "disabled": false,
                  "key": "contractType",
                  "value": "<string>",
                  "description": "(Required) Type of contracts to return in the chain. Can be CALL, PUT, or ALL. Default is ALL."
                },
                {
                  "disabled": false,
                  "key": "strikeCount",
                  "value": "<string>",
                  "description": "(Required) The number of strikes to return above and below the at-the-money price."
                },
                {
                  "disabled": false,
                  "key": "includeQuotes",
                  "value": "<string>",
                  "description": "(Required) Include quotes for options in the option chain. Can be TRUE or FALSE. Default is FALSE."
                },
                {
                  "disabled": false,
                  "key": "strategy",
                  "value": "<string>",
                  "description": "(Required) Passing a value returns a Strategy Chain. Possible values are SINGLE, ANALYTICAL (allows use of the volatility, underlyingPrice, interestRate, and daysToExpiration params to calculate theoretical values), COVERED, VERTICAL, CALENDAR, STRANGLE, STRADDLE, BUTTERFLY, CONDOR, DIAGONAL, COLLAR, or ROLL. Default is SINGLE."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },

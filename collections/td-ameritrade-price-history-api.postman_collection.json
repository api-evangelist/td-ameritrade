      "item": [
        {
          "id": "62df3685-8216-4fde-9a3b-80f6104b3a33",
          "name": "Historical price data for charts",
          "request": {
            "name": "Historical price data for charts",
            "description": {
              "content": "Get price history for a symbol",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "marketdata",
                ":symbol",
                "pricehistory"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "(Required) API Key"
                },
                {
                  "disabled": false,
                  "key": "periodType",
                  "value": "<string>",
                  "description": "(Required) The type of period to show. Valid values are day, month, year, or ytd (year to date). Default is day."
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<integer>",
                  "description": "(Required) The number of periods to show.\n\nExample: For a 2 day / 1 min chart, the values would be:\nperiod: 2\nperiodType: day\nfrequency: 1\nfrequencyType: min\nValid periods by periodType (defaults marked with an asterisk):\nday: 1, 2, 3, 4, 5, 10*\nmonth: 1*, 2, 3, 6\nyear: 1*, 2, 3, 5, 10, 15, 20\nytd: 1*"
                },
                {
                  "disabled": false,
                  "key": "frequencyType",
                  "value": "<string>",
                  "description": "(Required) The type of frequency with which a new candle is formed.\n\nValid frequencyTypes by periodType (defaults marked with an asterisk):\n\nday: minute*\nmonth: daily, weekly*\nyear: daily, weekly, monthly*\nytd: daily, weekly*\n"
                },
                {
                  "disabled": false,
                  "key": "frequency",
                  "value": "<integer>",
                  "description": "(Required) The number of the frequencyType to be included in each candle.\n\nValid frequencies by frequencyType (defaults marked with an asterisk):\n\nminute: 1*, 5, 10, 15, 30\ndaily: 1*\nweekly: 1*\nmonthly: 1*\n"
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<string>",
                  "description": "(Required) End date as milliseconds since epoch. If startDate and endDate are provided, period should not be provided. Default is previous trading day."
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<string>",
                  "description": "(Required) Start date as milliseconds since epoch. If startDate and endDate are provided, period should not be provided."
                },
                {
                  "disabled": false,
                  "key": "needExtendedHoursData",
                  "value": "<boolean>",
                  "description": "(Required) true to return extended hours data, false for regular market hours only. Default is true"
                },
                {
                  "disabled": false,
                  "key": "x",
                  "value": "<string>",
                  "description": "(Required) x"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "symbol",
                  "description": "(Required) Enter one symbol"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },

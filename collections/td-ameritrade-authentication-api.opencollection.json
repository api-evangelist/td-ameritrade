{
  "opencollection": "1.0.0",
  "info": {
    "name": "TD Ameritrade Accounts and Trading Authentication API",
    "version": "3.0.1"
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Post Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tdameritrade.com/v2/oath2/token",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "The token endpoint returns an access token along with an optional refresh token."
        }
      ]
    }
  ],
  "bundled": true
}